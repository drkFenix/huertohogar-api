[Unit]
Description=HuertoHogar API Spring Boot (DSY1104)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/huertohogar
EnvironmentFile=/home/ubuntu/huertohogar/huertohogar.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -jar app.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
